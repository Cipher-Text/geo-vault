{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-vault.local/schemas/bd/admin4.schema.json",
  "title": "Bangladesh Union (Admin Level 4)",
  "type": "object",
  "required": [
    "id",
    "division_id",
    "district_id",
    "upazila_id",
    "upazilla_id",
    "name",
    "bn_name",
    "slug",
    "country_code",
    "admin_level",
    "division_pcode",
    "district_pcode",
    "upazila_pcode",
    "url"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "division_id": { "type": "string" },
    "district_id": { "type": "string" },
    "upazila_id": { "type": "string" },
    "upazilla_id": { "type": "string" },
    "name": { "type": "string" },
    "bn_name": { "type": "string" },
    "slug": { "type": "string" },
    "country_code": { "type": "string" },
    "admin_level": { "type": "string" },
    "division_pcode": { "type": "string" },
    "district_pcode": { "type": "string" },
    "upazila_pcode": { "type": "string" },
    "pcode": {
      "type": "string",
      "description": "ADM4 p-code from the Bangladesh DGHS All_Union boundary service; present for unambiguous reconciliations."
    },
    "center_lat": {
      "type": "string",
      "description": "Polygon centroid latitude in WGS84; present for unambiguous reconciliations."
    },
    "center_lon": {
      "type": "string",
      "description": "Polygon centroid longitude in WGS84; present for unambiguous reconciliations."
    },
    "url": { "type": "string" }
  }
}
