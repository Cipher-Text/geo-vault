{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-vault.local/schemas/historical.schema.json",
  "title": "Historical geographic record",
  "description": "Common fields for sourced historical geographic and political records.",
  "type": "object",
  "required": ["id", "entity_type", "change_type", "valid_from", "valid_to", "source"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "entity_id": { "type": "string" },
    "entity_type": { "type": "string" },
    "country_code": { "type": "string" },
    "predecessor_entity_id": { "type": "string" },
    "successor_entity_id": { "type": "string" },
    "parent_entity_id": { "type": "string" },
    "name": { "type": "string" },
    "former_name": { "type": "string" },
    "current_name": { "type": "string" },
    "change_type": { "type": "string" },
    "description": { "type": "string" },
    "old_name": { "type": "string" },
    "new_name": { "type": "string" },
    "capital_city_id": { "type": "string" },
    "location_id": { "type": "string" },
    "value": { "type": "number" },
    "unit": { "type": "string" },
    "year": { "type": "integer" },
    "event_date": { "type": "string" },
    "valid_from": { "type": "string" },
    "valid_to": { "type": "string" },
    "source": { "type": "string" },
    "source_url": { "type": "string", "format": "uri" },
    "license": { "type": "string" }
  }
}
