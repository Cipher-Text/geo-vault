{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-vault.local/schemas/country.schema.json",
  "title": "Country",
  "type": "object",
  "required": [
    "id",
    "name",
    "official_name",
    "slug",
    "iso2",
    "iso3",
    "numeric_code",
    "fips_code",
    "geoname_id",
    "continent_code",
    "continent",
    "region",
    "subregion",
    "capital",
    "area_sqkm",
    "population",
    "population_source",
    "currency_code",
    "currency_name",
    "phone_code",
    "tld",
    "languages",
    "neighbours",
    "lat",
    "lon",
    "wikidata_id"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "official_name": { "type": "string" },
    "slug": { "type": "string" },
    "iso2": { "type": "string" },
    "iso3": { "type": "string" },
    "numeric_code": { "type": "string" },
    "fips_code": { "type": "string" },
    "geoname_id": { "type": "string" },
    "continent_code": { "type": "string" },
    "continent": { "type": "string" },
    "region": { "type": "string" },
    "subregion": { "type": "string" },
    "capital": { "type": "string" },
    "area_sqkm": { "type": "string" },
    "population": { "type": "string" },
    "population_source": { "type": "string" },
    "currency_code": { "type": "string" },
    "currency_name": { "type": "string" },
    "phone_code": { "type": "string" },
    "tld": { "type": "string" },
    "languages": { "type": "array", "items": { "type": "string" } },
    "neighbours": { "type": "array", "items": { "type": "string" } },
    "lat": { "type": "string" },
    "lon": { "type": "string" },
    "wikidata_id": { "type": "string" },
    "continent_id": { "type": "string" },
    "region_id": { "type": "string" },
    "currency_ids": { "type": "array", "items": { "type": "string" } },
    "language_ids": { "type": "array", "items": { "type": "string" } },
    "timezone_ids": { "type": "array", "items": { "type": "string" } },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "population_estimate": { "type": "integer" },
        "population_estimate_year": { "type": "integer" },
        "population_estimate_date": { "type": "string", "format": "date" },
        "population_estimate_source": { "type": "string" },
        "area_total_sqkm": { "type": "integer" },
        "area_land_sqkm": { "type": "integer" },
        "area_water_sqkm": { "type": "integer" },
        "area_source_year": { "type": "integer" },
        "area_source": { "type": "string" },
        "official_languages": { "type": "array", "items": { "type": "string" } },
        "language_policy": { "type": "string" },
        "primary_language": { "type": "string" },
        "common_languages": { "type": "array", "items": { "type": "string" } },
        "scheduled_languages": { "type": "array", "items": { "type": "string" } },
        "language_data_source": { "type": "string" },
        "time_zones": { "type": "array", "items": { "type": "string" } },
        "time_zone_count": { "type": "integer" },
        "utc_offset": { "type": "string" },
        "driving_side": { "type": "string", "enum": ["left", "right"] },
        "calling_code": { "type": "string" },
        "internet_country_code": { "type": "string" }
      }
    }
  }
}
