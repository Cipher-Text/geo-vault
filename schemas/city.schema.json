{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-vault.local/schemas/city.schema.json",
  "title": "City",
  "description": "Populated place with population greater than 15,000 (GeoNames cities15000).",
  "type": "object",
  "required": [
    "id",
    "geoname_id",
    "name",
    "ascii_name",
    "slug",
    "country_code",
    "admin1_code",
    "admin2_code",
    "admin3_code",
    "admin4_code",
    "lat",
    "lon",
    "population",
    "elevation",
    "dem",
    "timezone",
    "feature_class",
    "feature_code",
    "modification_date"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "geoname_id": { "type": "string" },
    "name": { "type": "string" },
    "ascii_name": { "type": "string" },
    "slug": { "type": "string" },
    "country_code": { "type": "string" },
    "admin1_code": { "type": "string" },
    "admin2_code": { "type": "string" },
    "admin3_code": { "type": "string" },
    "admin4_code": { "type": "string" },
    "lat": { "type": "string" },
    "lon": { "type": "string" },
    "population": { "type": "string" },
    "elevation": { "type": "string" },
    "dem": { "type": "string" },
    "timezone": { "type": "string" },
    "feature_class": { "type": "string" },
    "feature_code": { "type": "string" },
    "modification_date": { "type": "string" }
  }
}
