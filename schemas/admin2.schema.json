{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-vault.local/schemas/admin2.schema.json",
  "title": "Admin Level 2 Region",
  "description": "Second-level administrative division such as a district, county, or municipality.",
  "type": "object",
  "required": ["id", "name", "name_en", "local_name", "slug", "country_code", "country_iso3", "country_name", "admin_level", "type", "parent_code", "admin1_code", "admin2_code", "geoname_id", "geonames_code"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "name_en": { "type": "string" },
    "local_name": { "type": "string" },
    "slug": { "type": "string" },
    "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "country_iso3": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "country_name": { "type": "string" },
    "admin_level": { "const": "admin2" },
    "type": { "type": "string" },
    "parent_code": { "type": "string" },
    "admin1_code": { "type": "string" },
    "admin2_code": { "type": "string" },
    "geoname_id": { "type": "string" },
    "geonames_code": { "type": "string" }
  }
}
